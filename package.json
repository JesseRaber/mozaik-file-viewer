    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/viewer/viewer.test.ts"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
