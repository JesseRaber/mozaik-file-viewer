{
  "name": "mozaik-file-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local, read-only viewer for Mozaik cabinet job folders. Independent of Mozaik Software.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
